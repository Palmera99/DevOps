# ============================================
# .gitignore - Proyecto DevOps SaludConecta
# Previene la inclusión de secretos y temporales
# ============================================

# Variables de entorno y secretos
.env
.env.local
*.key
*.pem
*.cert

# Archivos de sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Logs y temporales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Paquetes y compilados
dist/
build/
*.zip
*.tar.gz
