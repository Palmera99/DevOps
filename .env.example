# ================================================================
# .env.example - Plantilla de Configuración de Entorno
# IMPORTANTE: Copie este archivo como .env y ajuste sus variables.
# NUNCA guarde credenciales reales ni claves privadas en el repositorio.
# ================================================================

# Entorno de ejecución (local, testing, production)
APP_ENV=local

# Nombre descriptivo de la aplicación
APP_NAME=SaludConecta-Web

# Puerto expuesto en el host para Docker Compose
PORT=8080

# Nivel de log de Nginx (debug, info, notice, warn, error, crit)
LOG_LEVEL=info
